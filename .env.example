# Data Contracts Demo Configuration
# ==================================
# Copy this file to .env and configure for your environment
# Run 'make init' to interactively create this file

# Deployment Type
# ---------------
# Options: cloud, local
DEPLOYMENT_TYPE=

# Container Runtime (for local deployment only)
# ---------------------------------------------
# Options: docker, podman
CONTAINER_RUNTIME=

# Confluent Cloud Credentials (for cloud deployment only)
# -------------------------------------------------------
# Get your API keys from: https://docs.confluent.io/cloud/current/security/authenticate/workload-identities/service-accounts/api-keys/overview.html
# CONFLUENT_CLOUD_API_KEY=your-api-key
# CONFLUENT_CLOUD_API_SECRET=your-api-secret

# Terraform Organization ID (for cloud deployment only)
# -----------------------------------------------------
# Get from: confluent organization list -o json | jq -c -r '.[] | select(.is_current)' | jq '.id'
# TF_VAR_org_id=your-org-id

# Demo Configuration (optional overrides)
# ---------------------------------------
# PRODUCER_INTERVAL=1
# PRODUCER_DURATION=10
# CONSUMER_GROUP_V1=membership-consumer-v1
# CONSUMER_GROUP_V2=membership-consumer-v2
# CONFIG_PATH=/confluent.properties
